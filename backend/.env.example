# Copy this file to backend/.env for local development. backend/.env is gitignored.
# On Render, set ANTHROPIC_API_KEY in the dashboard instead.
ANTHROPIC_API_KEY=sk-ant-...

# Number of tickets to embed into the vector store, starting from the first ticket.
# Embeddings are computed locally and cost nothing. More tickets need more memory.
RAG_MAX_TICKETS=3000

# Only for user-level keys (sk-ant-usr-...): the workspace to bill, from
# platform.claude.com -> Settings -> Workspaces. Not needed for sk-ant-api03- keys.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
