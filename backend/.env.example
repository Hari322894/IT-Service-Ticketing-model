# Copy this file to backend/.env and fill in real values. backend/.env is never committed.

# From platform.claude.com -> Settings -> API Keys (the account needs credits)
ANTHROPIC_API_KEY=sk-ant-...

# From Supabase -> Connect -> Direct -> "Session pooler" connection string.
# Replace [YOUR-PASSWORD] (and the brackets) with your database password.
# Special characters in the password must be encoded: # -> %23, @ -> %40
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres
